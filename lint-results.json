ve ? '#ffffff' : '#22d3ee';\n\n  return (\n    // @ts-expect-error - R3F JSX elements (group, mesh, primitive, etc.) are valid but not in TypeScript intrinsics\n    <group scale={1.2}>\n      {/* @ts-expect-error - R3F mesh element */}\n      <mesh ref={meshRef}>\n        <primitive object={geometry} attach=\"geometry\" />\n        <meshBasicMaterial\n          color={coreColor}\n          wireframe\n          transparent\n          opacity={0.1}\n          blending={THREE.AdditiveBlending}\n        />\n      </mesh>\n\n      <Points ref={pointsRef}>\n        <primitive object={geometry} attach=\"geometry\" />\n        <PointMaterial\n          transparent\n          color={coreColor}\n          size={0.015}\n          sizeAttenuation={true}\n          depthWrite={false}\n          blending={THREE.AdditiveBlending}\n        />\n      </Points>\n\n      <mesh>\n        <sphereGeometry args={[0.8, 32, 32]} />\n        <meshBasicMaterial\n          color={coreColor}\n          transparent\n          opacity={0.02}\n        />\n      </mesh>\n    </group>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\dev\\BC\\src\\components\\home\\ArtifactDossier.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"C:\\dev\\BC\\src\\components\\home\\BrandBuilderDemo.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'onTriggerConsumed' and 'startGeneration'. Either include them or remove the dependency array. If 'onTriggerConsumed' changes too often, find the parent component that defines it and wrap that definition in useCallback.","line":196,"column":6,"nodeType