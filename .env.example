# Environment Configuration Example
# Copy this file to .env and fill in your values

# =============================================================================
# Build Configuration
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=production

# Skip Puppeteer browser download (set to true if not using Puppeteer features)
# This is particularly important for Vercel deployments
PUPPETEER_SKIP_DOWNLOAD=true

# Skip prebuild pipeline (content generation)
# Set to "off" to skip AI/content generation during build
# PREBUILD_PIPELINE=off

# =============================================================================
# AI Features (Optional - disabled by default)
# =============================================================================

# Enable AI-powered features (default: false)
# AI_FEATURES_ENABLED=false

# OpenAI API Key (for GPT-based features)
# GPT_API_KEY=sk-...

# Google Gemini API Key
# GEMINI_API_KEY=AIza...

# AI Dry Run Mode (test without making real API calls)
# AI_DRY_RUN=true

# AI Rate Limiting (requests per minute per IP)
# AI_RATE_LIMIT_MAX=10

# AI Trace Logging (verbose logging for debugging)
# AI_TRACE_ENABLED=false

# =============================================================================
# MCP Server Configuration
# =============================================================================

# MCP Server Port
# MCP_PORT=5174

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Vercel Analytics
# VITE_VERCEL_ANALYTICS_ID=...

# =============================================================================
# Security
# =============================================================================

# Add any API keys or secrets below
# Never commit this file with real values!
# The .env file is in .gitignore for your protection

# =============================================================================
# Deployment Notes
# =============================================================================
# 
# For Vercel deployment:
# 1. Add these variables in Vercel Dashboard → Settings → Environment Variables
# 2. Set PUPPETEER_SKIP_DOWNLOAD=true to avoid build failures
# 3. AI features are disabled by default for security
# 4. See VERCEL_DEPLOYMENT.md for more details
